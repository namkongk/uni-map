# Copy to .env (never commit .env) and fill in. On Vercel, add the same names under
# Project → Settings → Environment Variables.
# Google Maps browser key: restrict it to your site URLs and to Maps JavaScript API + Places API (New).
GOOGLE_MAPS_API_KEY=
# Optional: your own Map ID (Google Maps Platform → Map Management). DEMO_MAP_ID works for testing.
GOOGLE_MAP_ID=DEMO_MAP_ID
# Supabase (database + accounts). Project URL and secret key: Supabase → Project Settings → API Keys.
SUPABASE_URL=
# Server-only key (sb_secret_…): never share or commit it.
SUPABASE_SECRET_KEY=
